<% layout("/layouts/boilerplate") %>

<h1 id="editheading">Edit the list</h1>

<form action="/listings/<%= individual._id %>/new?_method=PATCH"
      method="post"
      id="editform"
      class="needs-validation"
      data-bs-validate
      novalidate>

    <div class="mb-3">
        <label for="inputTitle" class="form-label">Title</label>
        <input type="text"
               id="inputTitle"
               name="title"
               class="form-control"
               placeholder="Enter title"
               value="<%= individual.title %>"
               required>

        <div class="invalid-feedback">
            Please enter a title.
        </div>
    </div>

    <div class="mb-3">
        <label for="inputDescription" class="form-label">Description</label>
        <textarea name="description"
                  id="inputDescription"
                  class="form-control"
                  placeholder="Describe the place"
                  required><%= individual.description %></textarea>

        <div class="invalid-feedback">
            Please enter a description.
        </div>
    </div>

    <br>

    <div class="mb-3">
        <label for="inputPrice" class="form-label">Price</label>
        <input type="number"
               id="inputPrice"
               name="price"
               min="0"
               class="form-control"
               placeholder="Enter price"
               value="<%= individual.price %>"
               required>

        <div class="invalid-feedback">
            Please enter a valid price.
        </div>
    </div>

    <br>

    <div class="mb-3">
        <label for="inputImage" class="form-label">Image</label>
        <input type="text"
               id="inputImage"
               name="image"
               class="form-control"
               placeholder="Enter the image URL"
               value="<%= individual.image.url %>">
    </div>

    <br>

    <div class="mb-3">
        <label for="inputCountry" class="form-label">Country</label>
        <input type="text"
               id="inputCountry"
               name="country"
               class="form-control"
               placeholder="Enter country"
               value="<%= individual.country %>"
               required>

        <div class="invalid-feedback">
            Please enter the country name.
        </div>
    </div>

    <br>

    <button class="btn btn-primary">Finish</button>

</form>