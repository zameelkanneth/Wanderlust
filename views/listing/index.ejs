<% layout("/layouts/boilerplate") %>
<diV><h3>All listings</h3></diV>
    


    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-3 g-4">
 <%for(list of allListings){%>
<a href="/listings/<%=list._id%>" class="cardanchor">
  <div class="card col" style="width: 20rem;">
  <div class="card-body p-3">
    <img src="<%=list.image.url%>" class="card-img-top" alt="listing_image">
    <p class="card-text fw-bold fg-2"> <%=list.title%></p>
    <p class="card-text fg-2"> &#8377;<b><%=list.price.toLocaleString('en-IN')%></p></b>/night</p>
   
  </div>
</div>


</a>

<% }%>

    </div>
 

